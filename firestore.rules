rules_version = '2';

// Reglas de seguridad de Firestore para WaterLedger.
// Implementa 4.1.4.5 (Validación de permisos backend) y mitiga R002 + R005.
//
// Modelo:
//   - users/{uid}: doc de cada usuario. Lo crea el cliente al registrarse.
//   - Solo el admin puede cambiar 'role', 'status' y 'permissions' después de creado.
//   - Solo el admin puede leer documentos de otros usuarios (para el dashboard
//     de pending approvals y para asignar auditor/certificador).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function callerData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && callerData().role == 'Admin'
        && callerData().status == 'active';
    }

    // Compartidas entre creditRequests y las colecciones de cola abierta
    // (certifications, insurancePlans) — no hay asignación 1:1 para estos
    // roles, cualquier profesional activo puede tomar una solicitud elegible.
    function isActiveCertifier() {
      return isSignedIn()
        && callerData().role == 'Certifier'
        && callerData().status == 'active';
    }

    function isActiveInsurer() {
      return isSignedIn()
        && callerData().role == 'Insurer'
        && callerData().status == 'active';
    }

    // Lista de campos cuyo cambio queda reservado al admin.
    // El cliente NO puede tocarlos sobre su propio doc.
    function touchesPrivileged(before, after) {
      return before.role != after.role
        || before.status != after.status
        || before.permissions != after.permissions;
    }

    // Lista de roles válidos del enum UserRole.
    function isValidRole(role) {
      return role in ['Retail', 'Company', 'Issuer', 'Auditor', 'Certifier', 'Insurer'];
    }

    // Status inicial permitido al crear un usuario desde el cliente.
    function isValidInitialStatus(role, status) {
      // Retail y Company se activan al toque. B2B (Issuer/Auditor/Certifier/Insurer)
      // quedan pending hasta que un admin los apruebe.
      return (role in ['Retail', 'Company'] && status == 'active')
          || (role in ['Issuer', 'Auditor', 'Certifier', 'Insurer'] && status == 'pending');
    }

    // ---------- users ----------
    match /users/{uid} {

      // Read:
      //   - El usuario puede leer su propio doc.
      //   - El admin puede leer cualquiera (dashboard de pending approvals).
      allow read: if isSelf(uid) || isAdmin();

      // Create: cualquiera signed-in puede crear SU propio doc, siempre que:
      //   - El uid del doc coincida con su auth.uid
      //   - El role sea uno válido y NO sea 'Admin' (admin solo se crea via consola
      //     o via el método registerAdmin con tooling separado)
      //   - El status inicial sea coherente con el role
      allow create: if isSelf(uid)
                    && request.resource.data.role != 'Admin'
                    && isValidRole(request.resource.data.role)
                    && isValidInitialStatus(
                         request.resource.data.role,
                         request.resource.data.status
                       );

      // Update:
      //   - El admin puede actualizar cualquier doc, incluyendo role/status/permissions
      //   - El usuario puede actualizar su propio doc PERO sin tocar campos privilegiados
      allow update: if isAdmin()
                    || (isSelf(uid) && !touchesPrivileged(resource.data, request.resource.data));

      // Delete:
      //   - Solo el admin puede borrar usuarios. Sin embargo, lo recomendado
      //     es soft-delete cambiando status, así queda historial.
      allow delete: if isAdmin();
    }

    // ---------- audit_log (preparado para R005 - LA005) ----------
    // Append-only. Solo admins leen/escriben. Nadie puede modificar o borrar
    // registros — son inmutables para auditoría.
    match /audit_log/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- creditRequests (módulo 4.2) ----------
    // Convención de paths Storage: creditRequests/{requestId}/documents/{type}/{filename}
    match /creditRequests/{requestId} {

      function isOwner() {
        return isSignedIn()
          && resource.data.issuerCompanyId == request.auth.uid;
      }

      function isCompany() {
        return isSignedIn()
          && callerData().role == 'Company'
          && callerData().status == 'active';
      }

      function isAssignedAuditor() {
        return isSignedIn()
          && callerData().role == 'Auditor'
          && callerData().status == 'active'
          && resource.data.get('assignedAuditorId', '') == request.auth.uid;
      }

      // Read: dueño de la solicitud, admin, auditor asignado, o certificador/
      // asegurador activo (cola abierta: necesitan leer la lista de
      // creditRequests filtrada por status para sus dashboards/listados).
      allow read: if isOwner()
                  || isAdmin()
                  || isAssignedAuditor()
                  || isActiveCertifier()
                  || isActiveInsurer();

      // Create: solo empresa activa creando su propio draft
      allow create: if isCompany()
                    && request.resource.data.issuerCompanyId == request.auth.uid
                    && request.resource.data.status == 'draft';

      // Update: dueño puede editar en draft; admin siempre; auditor asignado
      //   puede actualizar mientras la solicitud está en underAudit (para
      //   que FirebaseAuditRepository.submitConclusion pueda transicionar
      //   el status a certified / rejected via batch write); certificador
      //   activo mientras está en certified (issueCertificate/rejectCertification);
      //   asegurador activo mientras está en insured (createInsurancePlan/rejectInsurance).
      allow update: if isAdmin()
                    || (isOwner() && resource.data.status == 'draft')
                    || (isAssignedAuditor() && resource.data.status == 'underAudit')
                    || (isActiveCertifier() && resource.data.status == 'certified')
                    || (isActiveInsurer() && resource.data.status == 'insured');

      // Delete: solo admin (o dueño si está en draft, para borrar borradores)
      allow delete: if isAdmin()
                    || (isOwner() && resource.data.status == 'draft');
    }

    // ---------- audits (módulo 4.3) ----------
    // Un documento por creditRequest (mismo ID). El auditor asignado lo crea
    // al iniciar la auditoría y lo actualiza hasta enviarlo. Solo admin puede
    // leer/escribir desde la consola o herramientas de admin.
    match /audits/{requestId} {

      function isCreditRequestAuditor() {
        return isSignedIn()
          && callerData().role == 'Auditor'
          && callerData().status == 'active'
          && get(/databases/$(database)/documents/creditRequests/$(requestId))
               .data.get('assignedAuditorId', '') == request.auth.uid;
      }

      function isAuditOwner() {
        return isSignedIn() && resource.data.auditorId == request.auth.uid;
      }

      // Read: auditor asignado a esa creditRequest, dueño del audit (necesario
      // para que la query por 'auditorId' de auditorActivityProvider sea
      // estáticamente verificable y no la rechace Firestore), certificador
      // activo (necesita ver la conclusión de auditoría antes de certificar),
      // o admin
      allow read: if isCreditRequestAuditor() || isAuditOwner() || isActiveCertifier() || isAdmin();

      // Create: solo el auditor asignado; status inicial debe ser inProgress
      allow create: if isCreditRequestAuditor()
                    && request.resource.data.auditorId == request.auth.uid
                    && request.resource.data.status == 'inProgress';

      // Update: dueño del audit si todavía está inProgress, o admin
      allow update: if isAdmin()
                    || (isAuditOwner() && resource.data.status == 'inProgress');

      // Delete: solo admin (auditorías no se borran normalmente)
      allow delete: if isAdmin();
    }

    // ---------- insurancePlans (módulo 4.5) ----------
    // Un documento por creditRequest (mismo ID). A diferencia de audits, no hay
    // asegurador asignado 1:1 — cualquier Insurer activo puede tomar una
    // solicitud en estado 'insured' y crear o rechazar el plan.
    match /insurancePlans/{requestId} {

      // Read: cualquier asegurador activo (para listar/seguir su propia cola) o admin
      allow read: if isActiveInsurer() || isAdmin();

      // Create: solo el asegurador activo que firma el plan, sobre una solicitud
      // que esté efectivamente en estado 'insured'
      allow create: if isActiveInsurer()
                    && request.resource.data.insurerId == request.auth.uid
                    && request.resource.data.status in ['active', 'rejected']
                    && get(/databases/$(database)/documents/creditRequests/$(requestId))
                         .data.status == 'insured';

      // Update/Delete: el plan es inmutable una vez creado — solo admin
      allow update, delete: if isAdmin();
    }

    // ---------- certifications (módulo 4.4) ----------
    // Un documento por creditRequest (mismo ID). Igual que insurancePlans, no
    // hay certificador asignado 1:1 — cualquier Certifier activo puede tomar
    // una solicitud en estado 'certified' y emitir o rechazar el certificado.
    match /certifications/{requestId} {

      // Read: cualquier certificador activo (para listar/seguir su propia cola),
      // asegurador activo (necesita ver la certificación antes de asegurar), o admin
      allow read: if isActiveCertifier() || isActiveInsurer() || isAdmin();

      // Create: solo el certificador activo que firma, sobre una solicitud
      // que esté efectivamente en estado 'certified'
      allow create: if isActiveCertifier()
                    && request.resource.data.certifierId == request.auth.uid
                    && request.resource.data.status in ['issued', 'rejected']
                    && get(/databases/$(database)/documents/creditRequests/$(requestId))
                         .data.status == 'certified';

      // Update/Delete: la certificación es inmutable una vez creada — solo admin
      allow update, delete: if isAdmin();
    }

    // ---------- projects, valuations ----------
    // Colecciones referenciadas en KPIs del admin dashboard.
    // Por ahora: solo admin lee/escribe. Las reglas se irán afinando cuando
    // se implemente el módulo 4.6.4 (valuations recién entonces deja de ser
    // exclusivo del admin si hace falta).
    match /projects/{projectId} {
      allow read, write: if isAdmin();
    }
    match /valuations/{valId} {
      allow read, write: if isAdmin();
    }

    // ---------- default deny ----------
    // Cualquier otra colección queda cerrada hasta que se definan sus reglas
    // explícitamente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
